{
  "openapi": "3.1.0",
  "info": {
    "title": "Mars API",
    "description": "Mars catalog browsing and service capabilities.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "summary": "Complete Catalog",
        "operationId": "complete_catalog_api_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/landslides": {
      "get": {
        "summary": "List Landslides",
        "operationId": "list_landslides_api_landslides_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "SL",
                    "SP",
                    "FL",
                    "CL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Pagesize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlidePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/landslides/{slide_id}": {
      "get": {
        "summary": "Get Landslide",
        "operationId": "get_landslide_api_landslides__slide_id__get",
        "parameters": [
          {
            "name": "slide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slide Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slide"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Statistics",
        "operationId": "statistics_api_stats_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "SL",
                    "SP",
                    "FL",
                    "CL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_api_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/api/landslide/classify": {
      "post": {
        "summary": "Classify",
        "operationId": "classify_api_landslide_classify_post",
        "responses": {
          "503": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "dataMode": {
            "type": "string",
            "enum": [
              "demo",
              "catalog"
            ],
            "title": "Datamode"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "classifier": {
            "$ref": "#/components/schemas/Capability"
          },
          "detection": {
            "$ref": "#/components/schemas/Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataMode",
          "version",
          "classifier",
          "detection"
        ],
        "title": "Capabilities"
      },
      "Capability": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "available",
          "reason"
        ],
        "title": "Capability"
      },
      "Catalog": {
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "title": "Version"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "catalog"
            ],
            "title": "Mode"
          },
          "coordinateSystem": {
            "$ref": "#/components/schemas/CoordinateSystem"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/Slide"
            },
            "type": "array",
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "mode",
          "coordinateSystem",
          "records"
        ],
        "title": "Catalog"
      },
      "CoordinateSystem": {
        "properties": {
          "body": {
            "type": "string",
            "enum": [
              "Mars"
            ],
            "const": "Mars",
            "title": "Body"
          },
          "longitude": {
            "type": "string",
            "enum": [
              "east-positive, -180..180"
            ],
            "const": "east-positive, -180..180",
            "title": "Longitude"
          },
          "latitude": {
            "type": "string",
            "enum": [
              "planetocentric, degrees"
            ],
            "const": "planetocentric, degrees",
            "title": "Latitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "body",
          "longitude",
          "latitude"
        ],
        "title": "CoordinateSystem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "enum": [
              "mars-api"
            ],
            "const": "mars-api",
            "title": "Service"
          },
          "dataMode": {
            "type": "string",
            "enum": [
              "demo",
              "catalog"
            ],
            "title": "Datamode"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "dataMode",
          "version"
        ],
        "title": "Health"
      },
      "Slide": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "SL",
              "SP",
              "FL",
              "CL"
            ],
            "title": "Type"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "areaKm2": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Areakm2"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "imageUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imageurl"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "isDemo": {
            "type": "boolean",
            "title": "Isdemo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "name",
          "type",
          "longitude",
          "latitude",
          "areaKm2",
          "summary",
          "imageUrl",
          "source",
          "isDemo"
        ],
        "title": "Slide"
      },
      "SlidePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Slide"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "dataMode": {
            "type": "string",
            "enum": [
              "demo",
              "catalog"
            ],
            "title": "Datamode"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "dataMode",
          "version"
        ],
        "title": "SlidePage"
      },
      "Source": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "Source"
      },
      "Statistics": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "byType": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Bytype"
          },
          "dataMode": {
            "type": "string",
            "enum": [
              "demo",
              "catalog"
            ],
            "title": "Datamode"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "total",
          "byType",
          "dataMode",
          "version"
        ],
        "title": "Statistics"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
