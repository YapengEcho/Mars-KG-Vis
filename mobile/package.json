{
  "name": "mars-atlas-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "format": "prettier --write src vite.config.ts capacitor.config.ts",
    "format:check": "prettier --check src vite.config.ts capacitor.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@lucide/vue": "^1.59.0",
    "three": "^0.180.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
